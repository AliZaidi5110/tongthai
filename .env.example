# EmailJS Configuration for Table Reservations
# 1. Email Service ID from EmailJS Dashboard -> Email Services
NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_service_id

# 2. Email Template ID from EmailJS Dashboard -> Email Templates
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=your_template_id

# 3. Public Key from EmailJS Dashboard -> Account -> General
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_public_key
